// src/router/index.ts
import { createRouter, createWebHistory, type Router, type RouteLocationNormalized, type NavigationGuardNext } from 'vue-router'
import type { AppRouteRecordRaw } from './types'

// Import route modules
//import { homeRoutes } from './routes/home'
import { commonRoutes } from './routes/common.ts'
{{- range .Tables}}
import { {{.GetCamelCaseTableName}}Routes } from './routes/{{.GetCamelCaseTableName}}'
{{- end}}

// Combine all routes
const routes: AppRouteRecordRaw[] = [
 // ...homeRoutes,
 {{range .Tables}}
    ...{{.GetCamelCaseTableName}}Routes,
 {{- end}}
  ...commonRoutes
]


const router: Router = createRouter({
  history: createWebHistory(import.meta.env.BASE_URL),
  routes,
  scrollBehavior(to, from, savedPosition) {
    if (savedPosition) {
      return savedPosition
    } else {
      return { top: 0 }
    }
  }
})

// Navigation guard for setting page titles
router.beforeEach((to: RouteLocationNormalized, from: RouteLocationNormalized, next: NavigationGuardNext) => {
  const title = to.meta?.title as string | undefined
  document.title = title ? `${title} - Music App` : 'Music App'
  next()
})

export default router
