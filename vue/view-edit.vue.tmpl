    {{- with .CurrentTable.GetFirstPrimaryColumn }}
    params: { {{.GetCamelCaseColumnName}}: {{$.CurrentTable.GetCamelCaseTableName}}.{{.GetCamelCaseColumnName}}.toString() }
    {{- end -}}
  })
}

const handleCancel = () => {
  // Navigate back to view
  router.push({
    name: '{{.CurrentTable.GetPascalCaseTableName}}List',
    
  })
}
</script>

