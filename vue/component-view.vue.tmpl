<script setup lang="ts">
import { ref, onMounted, computed } from "vue"
import { {{.CurrentTable.GetCamelCaseTableName}}Service } from "@/services/{{.CurrentTable.GetPascalCaseTableName}}Service"
import type { {{if .CurrentTable.ForeignKeys}}{{.CurrentTable.GetPascalCaseTableName}}WithRelations{{else}}{{.CurrentTable.GetPascalCaseTableName}}{{end}} } from "@/types"

interface Props {
  {{- with .CurrentTable.GetFirstPrimaryColumn -}}
  {{.GetCamelCaseColumnName}}: {{.GetJavascriptDataType}}
  {{- end -}}
}

const props = defineProps<Props>()

const emit = defineEmits<{
  {{- with .CurrentTable.GetFirstPrimaryColumn -}}
  edit: [id: {{.GetJavascriptDataType}}]
  {{- end }}
  back: []
}>()

const {{.CurrentTable.GetCamelCaseTableName}} = ref<{{if .CurrentTable.ForeignKeys}}{{.CurrentTable.GetPascalCaseTableName}}WithRelations{{else}}{{.CurrentTable.GetPascalCaseTableName}}{{end}} | null>(null)
const loading = ref(false)
const error = ref("")

const formatDate = (date: string | null): string => {
  if (!date) return '-'
  return new Date(date).toLocaleDateString()
}

const load{{.CurrentTable.GetPascalCaseTableName}} = async () => {
  try {
    loading.value = true
    error.value = ""
    
    {{ with .CurrentTable.GetFirstPrimaryColumn }}
    const response = await {{$.CurrentTable.GetCamelCaseTableName}}Service.getById(props.{{.GetCamelCaseColumnName}})
    {{- end }}
    {{.CurrentTable.GetCamelCaseTableName}}.value = response.data
  } catch (err: unknown) {
    error.value = err.message || "Failed to load {{.CurrentTable.GetCamelCaseTableName}}"
    console.error("Error loading {{.CurrentTable.GetCamelCaseTableName}}:", err)
  } finally {
    loading.value = false
  }
}

onMounted(() => {
  load{{.CurrentTable.GetPascalCaseTableName}}()
})
</script>

